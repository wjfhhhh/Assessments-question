#### proc demo_pop_tool_environment {saved} {
####     dict for {key entry} $saved {
####         if {[lindex $entry 0]} {
####             set ::env($key) [lindex $entry 1]
####         } else {
####             unset -nocomplain ::env($key)
####         }
####     }
#### }
